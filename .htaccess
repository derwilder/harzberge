# harzberge.de: rein statische Seite. PHP und andere Skripte werden nicht ausgeführt.
Options -Indexes -ExecCGI
AddType video/webm .webm
AddType video/mp4 .mp4
ErrorDocument 404 /404.html

# Reste der alten Seite (Mobirise) nicht ausliefern
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^page2\.html$ / [R=301,L]
  RewriteRule ^(assets/|project\.mobirise$) - [R=404,L]
</IfModule>
<IfModule mod_authz_core.c>
  <FilesMatch "(?i)\.(php[0-9]?|phtml|phar|pl|py|cgi|sh)$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "\.(woff2|jpg|png|svg|css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.json$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Technische Adresse web58000.greatnet-hosting.de leitet auf die Hauptdomain um (kein Doppel-Inhalt, kein unverschlüsselter Zugriff)
<IfModule mod_rewrite.c>
  RewriteEngine On
  # www -> ohne www (eine Hauptadresse)
  RewriteCond %{HTTP_HOST} ^www\.harzberge\.de$ [NC]
  RewriteRule ^(.*)$ https://harzberge.de/$1 [R=301,L]
  RewriteCond %{HTTP_HOST} ^(www\.)?web58000\.greatnet-hosting\.de$ [NC]
  RewriteRule ^harzberge/?(.*)$ https://harzberge.de/$1 [R=301,L]
  RewriteCond %{HTTP_HOST} ^(www\.)?web58000\.greatnet-hosting\.de$ [NC]
  RewriteRule ^(.*)$ https://harzberge.de/$1 [R=301,L]
</IfModule>
